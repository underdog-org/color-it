{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://colorlull.app/contracts/colorpack.schema.json",
  "title": "colorpack",
  "description": "「.colorpack」內 JSON entry 的 SSOT。根 schema 描述 manifest.json；regions.json 見 $defs/regions。規格見 docs/specs/baker-core-design.md §3。",
  "$ref": "#/$defs/manifest",
  "$defs": {
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "content_hash",
        "canvas_size",
        "aspect",
        "region_count",
        "difficulty",
        "category",
        "has_shade",
        "palette"
      ],
      "properties": {
        "schema_version": {
          "description": "major.minor。runtime 拒絕未知 major。",
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "id": {
          "description": "永久識別碼，與來源資料夾名一致。小寫 kebab-case、純 ASCII。",
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "content_hash": {
          "description": "未壓縮內容的正規化 SHA-256（baker-core-design §3.3）。",
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "canvas_size": {
          "description": "輸出解析度 [w, h]：1:1 → [2048, 2048]，3:4 → [1536, 2048]。",
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 2,
          "maxItems": 2
        },
        "aspect": { "enum": ["1:1", "3:4"] },
        "region_count": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "difficulty": {
          "description": "門檻 SSOT 在 docs/specs/assets-spec.md §8：≤60 easy｜61–200 medium｜>200 focused。",
          "enum": ["easy", "medium", "focused"]
        },
        "category": {
          "enum": ["anime", "mandala", "animal", "botanical", "scenery", "cartoon"]
        },
        "has_shade": { "type": "boolean" },
        "palette": {
          "description": "去重後的建議色票，依總面積遞減排序（baker-core-design §3.5）。",
          "type": "array",
          "items": { "$ref": "#/$defs/hexColor" }
        }
      }
    },
    "regions": {
      "description": "regions.json：逐區記錄，index 即 region id，全部在輸出解析度。",
      "type": "array",
      "items": { "$ref": "#/$defs/regionEntry" }
    },
    "regionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "centroid", "area", "bbox", "suggested_color"],
      "properties": {
        "id": { "type": "integer", "minimum": 0, "maximum": 65534 },
        "centroid": {
          "description": "[x, y]，整數像素。",
          "type": "array",
          "items": { "type": "integer", "minimum": 0 },
          "minItems": 2,
          "maxItems": 2
        },
        "area": {
          "description": "輸出解析度的像素數。architecture §4.7 的進度計算直接拿它當分母。",
          "type": "integer",
          "minimum": 1
        },
        "bbox": {
          "description": "[x, y, w, h]。",
          "type": "array",
          "items": { "type": "integer", "minimum": 0 },
          "minItems": 4,
          "maxItems": 4
        },
        "suggested_color": { "$ref": "#/$defs/hexColor" }
      }
    },
    "hexColor": {
      "type": "string",
      "pattern": "^#[0-9A-F]{6}$"
    }
  }
}
